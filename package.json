{
  "name": "google-ads-admin-automation-backend",
  "version": "0.0.1",
  "description": "NestJS backend for Google Ads automation admin panel",
  "scripts": {
    "start": "ts-node src/main.ts",
    "start:dev": "ts-node src/main.ts",
    "start:gateway": "ts-node src/main.ts",
    "start:auth": "ts-node src/auth.microservice.ts",
    "start:users": "ts-node src/users.microservice.ts",
    "start:advertisers": "ts-node src/advertisers.microservice.ts",
    "start:campaigns": "ts-node src/campaigns.microservice.ts",
    "start:all": "concurrently \"npm run start:gateway\" \"npm run start:auth\" \"npm run start:users\" \"npm run start:advertisers\" \"npm run start:campaigns\"",
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/typeorm": "^10.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.11.0",
    "reflect-metadata": "^0.1.13",
    "typeorm": "^0.3.18"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/express": "^4.17.17",
    "@types/node": "^20.11.0",
    "@types/passport-jwt": "^4.0.1",
    "concurrently": "^8.2.0",
    "prettier": "^3.0.0",
    "ts-node": "^10.0.0",
    "typescript": "^5.5.0"
  }
}
